# Copy to .env.local and fill in. Never commit real secrets.

# Postgres (Neon serverless) — connection string
DATABASE_URL=postgresql://user:password@host/db

# Better Auth — random 32+ char secret (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=

# Public app URL (used for auth callbacks / links)
NEXT_PUBLIC_APP_URL=http://localhost:3700

# Upstash Redis — REST API creds (flag-config cache + rate limiting)
# Optional in dev: absent → endpoint degrades to Postgres, no rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
